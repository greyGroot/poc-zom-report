# Zoom Server-to-Server OAuth Credentials
# Отримайте в Zoom App Marketplace -> Server-to-Server OAuth App
ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

# Zoom Webhooks Secret Token
# Секретний токен для перевірки підпису та challenge-response валідації вебхуків
# Отримайте в Zoom App Marketplace -> Feature -> Event Subscriptions -> Secret Token
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token_here

# Upstash Redis REST Credentials
# Підключення до бази Upstash Redis (або Vercel Storage KV)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Опціонально: якщо використовується Vercel KV інтеграція напряму:
# KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
# KV_REST_API_TOKEN=your_upstash_redis_rest_token_here
