# ==========================================
# Schoolmate CRM Credentials
# ==========================================
SCHOOLMATE_BASE_URL=https://empireenglish.schoolmate.eu
SCHOOLMATE_PREFIX=empireenglish
SCHOOLMATE_USERNAME=Izai1498
SCHOOLMATE_PASSWORD=your_schoolmate_password_here
SCHOOLMATE_ADMIN_USER_ID=743140

# ==========================================
# Database / Persistence (Independent EE-CRM Upstash Redis)
# ==========================================
# Primary EE-CRM Redis instance credentials:
EE_CRM_REDIS_REST_URL=https://your-ee-crm-redis.upstash.io
EE_CRM_REDIS_REST_TOKEN=your_ee_crm_redis_token

# Fallbacks automatically provisioned by Vercel KV or standard Upstash:
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_token
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# If not set, ee-crm will automatically fall back to an in-memory store for local development.

# ==========================================
# Zoom Webhook Ingestion Configuration
# ==========================================
# Secret token configured in the Zoom Marketplace Webhook app for HMAC-SHA256 signature verification and CRC challenge:
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token_here

# ==========================================
# Google OAuth & NextAuth Configuration
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_here

# ==========================================
# Application Settings
# ==========================================
PORT=3001
NODE_ENV=development

# ==========================================
# TEMPORARY MIGRATION-ONLY POC CREDENTIALS (CRM-005)
# ==========================================
# WARNING: The following variables are strictly for running the one-time CRM-005 historical
# migration scripts (scripts/crm-005/). They must NEVER be set or retained in production runtime!
# POC_REDIS_REST_URL=https://your-legacy-poc-redis.upstash.io
# POC_REDIS_REST_TOKEN=your_legacy_poc-redis_token
